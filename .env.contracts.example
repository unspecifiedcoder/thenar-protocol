# .env.contracts — where GraspLog actually lives (T-009).
#
# One `CHAIN_<id>_*` block per deployed chain. `services/log/src/chains.ts`
# parses this file; `scripts/gen-chains.mjs` reads it to write
# `apps/web/chains.js`; `scripts/deploy-chain.sh` appends to it after a
# deploy. Copy this file to `.env.contracts` (git-ignored — real addresses
# are not a secret, but keeping one canonical file for both deployed and
# undeployed test setups avoids a second source of truth) and fill in real
# values as each chain is deployed.
#
# D-9: Avalanche C-Chain (Fuji here) is primary; Ethereum (Sepolia here) is
# the mirror. `ROLE` must be exactly one `primary` per file; `REGISTRY` only
# exists on the primary (`LicenceRegistry` is primary-chain only).

CHAIN_43113_ROLE=primary
CHAIN_43113_LOG=0x0000000000000000000000000000000000000000
CHAIN_43113_VERIFIER=0x0000000000000000000000000000000000000000
CHAIN_43113_REGISTRY=0x0000000000000000000000000000000000000000
CHAIN_43113_RPC=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_43113_FROM_BLOCK=0

CHAIN_11155111_ROLE=mirror
CHAIN_11155111_LOG=0x0000000000000000000000000000000000000000
CHAIN_11155111_VERIFIER=0x0000000000000000000000000000000000000000
CHAIN_11155111_RPC=https://ethereum-sepolia-rpc.publicnode.com
